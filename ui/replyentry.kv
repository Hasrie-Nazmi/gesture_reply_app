<ReplyEntry>:
    BoxLayout:
        orientation: 'vertical'
        padding: 40
        spacing: 20

        Button:
            text: "<-"
            size_hint: (0.1, 0.1)
            background_color: (0.1, 0.5, 0.8, 1)
            color: (1, 1, 1, 1)
            font_size: 16
            on_press: root.go_back(self)

        Spinner:
            id: spinner_gestures
            text: "Select Gesture"
            values: ["Gesture 0", "Gesture 1", "Gesture 2", "Gesture 3", "Gesture 4", "Gesture 5", "Thumbs Up"]
            size_hint: (1, 0.15)
            background_color: (0.1, 0.5, 0.8, 1)
            font_size: 18
            on_text: root.on_spinner_select(self.text)

        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: 0.6
            spacing: 10

            Image:
                id: cam_image
                size_hint: (1, 0.75)

            Image:
                id: gesture_img
                size_hint: (1, 0.75)

        TextInput:
            id: reply_input
            text: ''
            hint_text: 'Type your message here...'
            multiline: True  # Set to True if you want a multi-line text box
            size_hint: (1, 0.1)
            font_size: 18

        Button:
            text: "Set Reply"
            size_hint: (0.5, 0.1)
            background_color: (0.1, 0.5, 0.8, 1)
            color: (1, 1, 1, 1)
            font_size: 18
            on_press: root.on_button_click(self)