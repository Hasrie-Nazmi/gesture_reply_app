<ReplyEntry>:
    BoxLayout:
        orientation: 'vertical'
        padding: 40
        spacing: 20

        Button:
            text: "<-"
            size_hint: (0.1, 0.08)
            background_color: (0.1, 0.5, 0.8, 1)
            color: (1, 1, 1, 1)
            font_size: 16
            on_press: root.go_back(self)

        Spinner:
            id: spinner_gestures
            text: "Gesture 0"
            values: ["Gesture 0", "Gesture 1", "Gesture 2", "Gesture 3", "Gesture 4", "Gesture 5", "Thumbs Up"]
            size_hint: (1, 0.08)
            background_color: (0.1, 0.5, 0.8, 1)
            font_size: 18
            on_text: root.on_spinner_select(self.text)

        Image:
            id: gesture_img
            size_hint: (1, 0.55)
            source: "../assets/gesture_zero.jpg"

        TextInput:
            id: reply_input
            text: ''
            hint_text: 'Set your reply here...'
            multiline: True
            size_hint: (1, 0.15)
            font_size: 18

        BoxLayout:
            orientation: 'horizontal'
            size_hint: (1, None)    
            height: 60                         
            spacing: 15    

            Button:
                text: "Set Reply"
                font_size: 16
                on_press: root.set_reply()    

            Button:
                text: "Export Config"
                font_size: 16
                on_press: root.export_config_to_json()    
                
            Button:
                text: "Import Config"
                font_size: 16
                on_press: root.import_config_from_json()