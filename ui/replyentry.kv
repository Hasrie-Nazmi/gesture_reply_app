<ReplyEntry>:
    orientation: 'vertical'
    padding: 40
    spacing: 20

    Spinner:
        id: mode_spinner
        text: "Select Gesture"
        values: ["Gesture 1", "Gesture 2", "Gesture 3", "Gesture 4", "Gesture 5", "Thumbs Up", "Peace Sign"]
        size_hint: (1, 0.15)
        # Optional styling
        background_color: (0.1, 0.5, 0.8, 1)
        font_size: 18
        # Triggers a Python function whenever a new option is chosen
        on_text: root.on_spinner_select(self.text)

    Label:
        text: "Gesture 1"
        size_hint: (1, 0.1)
        font_size: 24

    Image:
        id: cam_image
        size_hint: (1, 0.75)